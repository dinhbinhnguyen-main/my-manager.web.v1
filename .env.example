# Cấu hình cơ sở dữ liệu SQLite products.db
# Trên Linux (mặc định hiện tại):
DB_PATH=/home/dinhbinhnguyen/Devs/my-manager.v1/bin/products.db
# Trên macOS (ví dụ):
# DB_PATH=/Users/dinhbinhnguyen/Devs/my-manager.v1/bin/products.db

# Cấu hình thư mục chứa ảnh sản phẩm
# Trên Linux (mặc định hiện tại):
IMAGES_DIR=/home/dinhbinhnguyen/Devs/my-manager.v1/bin/products
# Trên macOS (ví dụ):
# IMAGES_DIR=/Users/dinhbinhnguyen/Devs/my-manager.v1/bin/products
# Hoặc ổ cứng ngoài: IMAGES_DIR=/Volumes/Storage/Images

# Cấu hình Web Server
PORT=8000
HOST=0.0.0.0

# Thông tin liên hệ hiển thị trên web
CONTACT_PHONE=0949940987
CONTACT_ZALO=0949940987
SITE_NAME="BĐS Đà Lạt Luxury"

# Ưu tiên ảnh có đóng dấu bản quyền: true/false (nếu không có sẽ tự fallback sang ảnh gốc)
PREFER_WATERMARK=true

# Cấu hình môi trường Conda (nếu bạn dùng Conda thay vì venv):
# Ví dụ: CONDA_ENV=base hoặc CONDA_ENV=my-manager (nếu để trống script sẽ tự nhận diện)
# CONDA_ENV=base
